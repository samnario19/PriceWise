# Vercel → Settings → Environment Variables → Production (and Preview).
# Render origin only. Never the *.vercel.app URL. No trailing slash.
BACKEND_URL=https://your-service.onrender.com

# Needed for client-side scraping (Lazada / Shopee) to bypass Vercel's 10 s timeout.
# Set this to the same Render origin. Must start with PUBLIC_ so SvelteKit exposes it to the browser.
PUBLIC_BACKEND_URL=https://your-service.onrender.com
